# Use the web client ID for Expo Go/proxy-style flows when applicable.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=1060977802251-j0thmej4222v20vqjrugia8ir1g284gb.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1060977802251-j0thmej4222v20vqjrugia8ir1g284gb.apps.googleusercontent.com

# Use platform client IDs for development/production native builds.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
