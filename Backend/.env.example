MONGO_URI=mongodb://localhost:27017/doandanentang
JWT_SECRET=dev_secret

# Google OAuth client IDs accepted by /api/auth/google.
# GOOGLE_CLIENT_ID is the web client ID used by the web app.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# MinIO internal address used by backend.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123

# Public URL that browser/mobile clients can reach.
# If another machine uses your backend over LAN, replace 192.168.1.5 with your backend machine IP.
MINIO_PUBLIC_URL=http://192.168.1.5:9000
