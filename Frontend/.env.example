# MiniSocial Frontend — Environment Variables
# Copy file này thành .env và điền giá trị

# Backend API Base URL (default: http://localhost:3000/api)
VITE_API_BASE_URL=http://localhost:3000/api

# Socket.IO Server URL (default: http://localhost:3000)
VITE_SERVER_URL=http://localhost:3000

# Google OAuth Client ID (để trống nếu không dùng Google login)
VITE_GOOGLE_CLIENT_ID=